@using Garage_2.Models.ViewModels
@model UserOverviewViewModel

@{
    ViewData["Title"] = "Users";

    UserOverviewSortOrder GetSortOrder(UserOverviewSortBy sortBy)
    {
        if (Model.SortBy == sortBy)
        {
            return Model.SortOrder == UserOverviewSortOrder.Ascending
                ? UserOverviewSortOrder.Descending
                : UserOverviewSortOrder.Ascending;
        }

        return Model.SortOrder ?? UserOverviewSortOrder.Ascending;
    }
    ;

    string GetSortOrderIndicatorStyle()
    {
        string rotation = Model.SortOrder == UserOverviewSortOrder.Ascending
            ? ""
            : "transform: rotate(0.5turn);";

        return rotation + " display: inline-block; width: 1rem; line-height: 1rem; text-align: center; font-size: 0.75rem";
    }
}

@if (TempData["AlertMessage"] is string alert && TempData["AlertType"] is string type)
{
    <div class="position-fixed w-100 bottom-0 start-0 mb-3" style="z-index: 1080;">
        <div class="alert alert-@type alert-dismissible fade show shadow w-75 m-auto" role="alert">
            @alert
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<div class="position-fixed bg-body start-0 end-0 z-1"
     style="top: 48px; @@media (min-width: 768px) { top: 57px }">

    <div class="container p-3">
        <h4 class="mb-0">Users overview</h4>
    </div>

    <div class="container d-flex p-3 px-4 gap-2 align-items-center">
        <div class="d-none d-sm-flex text-nowrap align-items-center gap-1">
            Registered users: @Model.Count
        </div>

        <div class="d-flex flex-grow-1 justify-content-end">
            <form asp-action="Index" method="get" class="d-flex gap-2" style="max-width: 520px; width: 100%;">
                <input name="searchString"
                       value="@Model.SearchString"
                       class="form-control"
                       placeholder="Search name or email..."
                       autocomplete="off" />

                @if (!string.IsNullOrWhiteSpace(Model.SearchString))
                {
                    <a asp-action="Index" class="btn btn-outline-danger text-nowrap">Clear</a>
                }
                <button type="submit" class="btn btn-secondary text-nowrap">Search</button>


                <input type="hidden" name="sortBy" value="@Model.SortBy" />
                <input type="hidden" name="order" value="@Model.SortOrder" />
                <input type="hidden" name="page" value="@Model.CurrentPage" />
            </form>
        </div>
    </div>
</div>

<table class="table table-striped" style="margin-top: 180px;">
    <thead class="position-sticky w-100 bg-body z-2"
           style="top: 108px; box-shadow: 0 4px 4px -4px rgba(0,0,0,0.2); @@media (min-width: 768px) { top: 118px }">
        <tr>
            <th class="text-nowrap">
                <a asp-action="Index"
                   asp-route-sortBy="@UserOverviewSortBy.FullName"
                   asp-route-order="@GetSortOrder(UserOverviewSortBy.FullName)"
                   asp-route-searchString="@Model.SearchString"
                   asp-route-page="@Model.CurrentPage">
                    @Html.DisplayNameFor(m => m.OverviewItem.FullName)
                </a>
                @if (Model.SortBy == UserOverviewSortBy.FullName)
                {
                    <div class="text-primary" style="@GetSortOrderIndicatorStyle()">&#9650;</div>
                }
            </th>

            <th class="text-nowrap d-none d-md-table-cell">
                <a asp-action="Index"
                   asp-route-sortBy="@UserOverviewSortBy.Email"
                   asp-route-order="@GetSortOrder(UserOverviewSortBy.Email)"
                   asp-route-searchString="@Model.SearchString"
                   asp-route-page="@Model.CurrentPage">
                    @Html.DisplayNameFor(m => m.OverviewItem.Email)
                </a>
                @if (Model.SortBy == UserOverviewSortBy.Email)
                {
                    <div class="text-primary" style="@GetSortOrderIndicatorStyle()">&#9650;</div>
                }
            </th>

            <th class="text-nowrap">
                <a asp-action="Index"
                   asp-route-sortBy="@UserOverviewSortBy.VehicleCount"
                   asp-route-order="@GetSortOrder(UserOverviewSortBy.VehicleCount)"
                   asp-route-searchString="@Model.SearchString"
                   asp-route-page="@Model.CurrentPage">
                    @Html.DisplayNameFor(m => m.OverviewItem.VehicleCount)
                </a>
                @if (Model.SortBy == UserOverviewSortBy.VehicleCount)
                {
                    <div class="text-primary" style="@GetSortOrderIndicatorStyle()">&#9650;</div>
                }
            </th>

            <th class="text-nowrap">
                <a asp-action="Index"
                   asp-route-sortBy="@UserOverviewSortBy.TotalActiveCostNow"
                   asp-route-order="@GetSortOrder(UserOverviewSortBy.TotalActiveCostNow)"
                   asp-route-searchString="@Model.SearchString"
                   asp-route-page="@Model.CurrentPage">
                    Total cost (active parking)
                </a>
                @if (Model.SortBy == UserOverviewSortBy.TotalActiveCostNow)
                {
                    <div class="text-primary" style="@GetSortOrderIndicatorStyle()">&#9650;</div>
                }
            </th>

            <th></th>
        </tr>
    </thead>

    <tbody>
        @if (!Model.OverviewList.Any())
        {
            <tr>
                <td colspan="5" class="text-muted py-4">No users found.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model.OverviewList)
            {
                <tr>
                    <td class="text-nowrap">@item.FullName</td>

                    <td class="text-nowrap d-none d-md-table-cell">
                        @(string.IsNullOrWhiteSpace(item.Email) ? "-" : item.Email)
                    </td>

                    <td class="text-nowrap">
                        <span class="badge bg-secondary">@item.VehicleCount</span>
                    </td>

                    <td class="text-nowrap">
                        @if (item.TotalActiveCostNow <= 0)
                        {
                            <span class="text-muted">-</span>
                        }
                        else
                        {
                            <span class="fw-semibold">@item.TotalActiveCostNow.ToString("C")</span>
                            <span class="badge bg-success ms-2">Active</span>
                        }
                    </td>

                    <td>
                        <div class="d-flex flex-nowrap gap-2">
                            <a asp-action="Details"
                               asp-route-id="@item.UserId"
                               class="btn btn-sm btn-outline-secondary text-nowrap">
                                Details
                            </a>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<div class="mt-3">
    <span>Page: </span>
     @for (int i = 1; i <= Model.TotalPages; i++)
    {
        <a asp-action="Index"
        asp-route-sortBy="@Model.SortBy"
           asp-route-order="@Model.SortOrder"
           asp-route-searchString="@Model.SearchString"
           asp-route-page="@i"
           class="btn btn-sm @(i == Model.CurrentPage ? "btn-primary" : "btn-outline-primary")">
            @i
        </a>
    }
</div>

