@model IEnumerable<Garage_2.Models.Entities.ParkingSpotV2>

@{
    ViewData["Title"] = "Manage Spots";
}

<h1>Parking spots</h1>

<a asp-action="Create" class="btn btn-primary">Create new parking spot</a>

<table class="table">
    <thead>
        <tr>
            <th>Parking number</th>
            <th>Occupancy</th>
            <th>Status</th>
            <th>Capacity</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var occupiedUnits = item.VehicleParkings
            .Where(vp => vp.ParkingSession.DepartureTime == null)
            .Sum(vp => vp.UnitsUsed);
            <tr>
                <td>@item.SpotNumber</td>

                <td>
                    @if (occupiedUnits == 0)
                    {
                        <span class="text-muted">Empty</span>
                    }
                    else if (occupiedUnits >= item.CapacityUnits)
                    {
                        <span style="color:red; font-weight:bold;">Full</span>
                    }
                    else
                    {
                        <span class="fw-bold">@occupiedUnits / @item.CapacityUnits</span>
                    }
                </td>

                <td>
                    @if (item.IsBlocked)
                    {
                        <span style="color:red; font-weight:bold;">Blocked</span>
                    }
                    else
                    {
                        <span>Open</span>
                    }
                </td>

                <td>@item.CapacityUnits</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary text-nowrap">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>