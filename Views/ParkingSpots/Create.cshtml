@model Garage_2.Models.Entities.ParkingSpotV2

@{
    ViewData["Title"] = "Create spots";
}
<h1>Create new parking spot</h1>

<form asp-action="Create">

    <div class="form-group">
        <label>Spot Number:</label>
        <input asp-for="SpotNumber" class="form-control" type="number" />
        <span asp-validation-for="SpotNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>
            <input asp-for="IsBlocked" type="checkbox" />
            Block this spot?
        </label>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index">Back to list</a>

</form>