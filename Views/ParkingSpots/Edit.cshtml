@model Garage_2.Models.Entities.ParkingSpotV2

@{
    ViewData["Title"] = "Edit spots";
}
<h1>Edit parking spot</h1>

<form asp-action="Edit">

    <input type="hidden" asp-for="Id" />

    <div class="form-group mb-3">
        <label class="control-label">Parking number:</label>
        <input asp-for="SpotNumber" class="form-control" type="number" />
        <span asp-validation-for="SpotNumber" class="text-danger"></span>
    </div>

    <div class="form-group" style="margin-top: 20px; margin-bottom: 20px;">
        <label style="font-weight: bold; color: red;">
            <input asp-for="IsBlocked" type="checkbox" />
            Block this spot?
        </label>
    </div>
    <a asp-action="Index">Back to list</a>
    <button type="submit" class="btn btn-primary">Save Changes</button>


</form>