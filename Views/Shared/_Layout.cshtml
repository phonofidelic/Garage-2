<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Garage 3.0</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Garage_2.styles.css" asp-append-version="true" />
    <script src="~/js/color-theme-picker.js">-</script>
</head>

<body>
    <header class="px-3 position-fixed w-100 top-0 end-0 bg-body text-body z-3">
        <nav class="container navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow no-print">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Vehicles" asp-action="Index">Garage 3.0</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <div class="dropdown">
                                    <button class="btn btn-link dropdown-toggle nav-link" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Vehicles
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="nav-link" asp-controller="Vehicles" asp-action="Index">
                                                Registered
                                                Vehicles
                                            </a>
                                        </li>
                                        <li>
                                            <a class="nav-link"
                                               asp-controller="UserVehicles"
                                               asp-action="Index">User Vehicles</a>
                                        </li>
                                    </ul>
                                </div>
                            </li>
                            <li class="nav-item">
                                <div class="dropdown">
                                    <button class="btn btn-link dropdown-toggle nav-link" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Parking
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li class="nav-item">
                                            <a class="nav-link"
                                               asp-controller="ParkingSpots"
                                               asp-action="Index">Manage Spots</a>
                                        </li>
                                        <li>
                                            <a class="nav-link" asp-controller="ParkingSessions" asp-action="Index">
                                                Parking
                                                History
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="UserRoles" asp-action="Index">Admin</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="GarageStatistics"
                                   asp-action="GarageStatsOverview">Garage Statistics</a>
                            </li>
                        } else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Vehicles" asp-action="Index">Registered
                                    Vehicles</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="UserVehicles"
							       asp-action="Index">User Vehicles</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="ParkingSessions" asp-action="Index">Parking
                                    History</a>
                            </li>
                            
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="container pb-3" style="margin-top: 60px">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">
            <div class="d-flex w-100 justify-content-between align-items-center">
                <div>&copy; 2025 - Garage 2.0 - <a asp-area="" asp-controller="Vehicles"
                        asp-action="Privacy">Privacy</a>
                </div>
                <div class="dropup">
                    <button class="btn btn-sm btn-link px-0 px-lg-2 py-2 dropdown-toggle d-flex align-items-center"
                        id="bd-theme" type="button" aria-expanded="false" data-bs-toggle="dropdown"
                        data-bs-display="static" aria-label="Toggle theme (dark)">
                        <span class="ms-2" id="bd-theme-text">
                            Toggle theme
                        </span>
                    </button>
                    <div>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="bd-theme-text">
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center"
                                    data-bs-theme-value="light">
                                    Light
                                </button>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center"
                                    data-bs-theme-value="dark">
                                    Dark
                                </button>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center"
                                    data-bs-theme-value="auto">
                                    Auto
                                </button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>