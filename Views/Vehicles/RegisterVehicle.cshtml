@model Garage_2.Models.ViewModels.RegisterVehicleViewModel

@{
    ViewData["Title"] = "Register vehicle";
}

<h1>Register vehicle</h1>

<h4>Enter vehicle information</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="RegisterVehicle" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="RegistrationNumber" class="control-label fw-bold"></label>
                <input asp-for="RegistrationNumber" class="form-control" />
                <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Make" class="control-label fw-bold"></label>
                <input asp-for="Make" class="form-control" />
                <span asp-validation-for="Make" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Model" class="control-label fw-bold"></label>
                <input asp-for="Model" class="form-control" />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NumberOfWheels" class="control-label fw-bold"></label>
                <input asp-for="NumberOfWheels" class="form-control" />
                <span asp-validation-for="NumberOfWheels" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Color" class="control-label fw-bold"></label>
                <input asp-for="Color" class="form-control" />
                <span asp-validation-for="Color" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="VehicleTypeId" class="control-label fw-bold"></label>
                <select asp-for="VehicleTypeId"
                        class="form-control"
                        asp-items="Model.VehicleTypes">
                    <option value="">-- Select vehicle type --</option>                    
                </select>
                <span asp-validation-for="VehicleTypeId" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                <input type="submit" value="Register vehicle" class="btn btn-success" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
